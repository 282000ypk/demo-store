# PhonePe Payment Gateway Configuration
# For local development: copy this file to .env and fill in your credentials
# For Netlify: set these in Site Settings → Environment Variables
# ⚠️ NEVER commit .env file to version control

# Flask secret key (set a strong random value in production)
FLASK_SECRET_KEY=change-this-to-a-real-secret-key

# Environment (sandbox or production)
PHONEPE_ENV=sandbox

# API Credentials
PHONEPE_CLIENT_ID=your_client_id
PHONEPE_CLIENT_SECRET=your_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=your_merchant_id
